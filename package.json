{
  "name": "kube-together",
  "version": "0.1.0",
  "private": true,
  "description": "Local Kubernetes training dashboard and lab control service",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "sync-course": "node training/scripts/Sync-Course.cjs",
    "test:browser": "playwright test",
    "package:preview": "node scripts/release/preview.cjs",
    "release:validate-pr": "node scripts/release/validate-pr.cjs",
    "release:publish": "node scripts/release/publish.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  },
  "license": "MIT"
}
